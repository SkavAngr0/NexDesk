generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id      String   @id @default(cuid())
  name    String   @unique
  country String
  assets  Asset[]
  tickets Ticket[]
}

model User {
  id              String    @id @default(cuid())
  employeeId      String    @unique
  name            String
  email           String    @unique
  department      String?
  jobTitle        String?
  role            String
  assignedAssets  Asset[]   @relation("AssignedUser")
  requestedTickets Ticket[] @relation("Requester")
  assignedTickets Ticket[]  @relation("Technician")
  articles        KnowledgeArticle[]
}

model Asset {
  id              String   @id @default(cuid())
  assetTag        String   @unique
  type            String
  manufacturer    String
  model           String
  serialNumber    String   @unique
  os              String?
  status          String
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  notes           String?
  location        Location? @relation(fields: [locationId], references: [id])
  locationId      String?
  assignedUser    User?     @relation("AssignedUser", fields: [assignedUserId], references: [id])
  assignedUserId  String?
  tickets         Ticket[]
}

model Ticket {
  id            String   @id @default(cuid())
  ticketNumber  String   @unique
  title         String
  description   String
  category      String
  priority      String
  status        String   @default("Open")
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location      Location? @relation(fields: [locationId], references: [id])
  locationId    String?

  asset         Asset?   @relation(fields: [assetId], references: [id])
  assetId       String?

  requester     User     @relation("Requester", fields: [requesterId], references: [id])
  requesterId   String

  technician    User?    @relation("Technician", fields: [technicianId], references: [id])
  technicianId  String?
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  category    String
  problem     String
  steps       String[]
  solution    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
}